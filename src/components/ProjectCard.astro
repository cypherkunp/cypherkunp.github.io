---
interface Props {
  name: string;
  description: string | null;
  url: string;
  homepageUrl: string | null;
  stargazerCount: number;
  forkCount: number;
  pushedAt: string;
  primaryLanguage: { name: string; color: string | null } | null;
}

const { name, description, url, homepageUrl, stargazerCount, forkCount, pushedAt, primaryLanguage } = Astro.props;
const updated = new Date(pushedAt).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
---

<article class="card">
  <h3><a href={url}>{name}</a></h3>
  {description && <p class="desc">{description}</p>}
  <ul class="meta">
    {primaryLanguage && (
      <li>
        <span class="dot" style={`--lang:${primaryLanguage.color ?? 'var(--muted)'}`}></span>
        {primaryLanguage.name}
      </li>
    )}
    {stargazerCount > 0 && <li>★ {stargazerCount}</li>}
    {forkCount > 0 && <li>⑂ {forkCount}</li>}
    <li>Updated {updated}</li>
    {homepageUrl && <li><a href={homepageUrl}>{new URL(homepageUrl).host}</a></li>}
  </ul>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    transition: border-color 150ms ease-out;
  }
  .card:hover {
    border-color: var(--border-strong);
  }
  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }
  h3 a {
    color: var(--accent);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card {
    position: relative;
  }
  .desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.8rem;
  }
  .meta a {
    position: relative;
    z-index: 1;
    color: inherit;
  }
  .dot {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.35em;
    border-radius: 50%;
    background: var(--lang);
    vertical-align: -0.05em;
  }
</style>
